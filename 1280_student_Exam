with total_Students as (select * from students cross join subjects)
select ts.student_id, ts.student_name, ts.subject_name ,sum(decode(exam.student_id,null,0,1)) as attended_exams
from total_Students ts
left join Examinations exam
on ts.student_id =exam.student_id
and ts.subject_name = exam.subject_name
group by ts.student_id, ts.student_name, ts.subject_name
order by ts.student_id, ts.student_name
