select 
to_char(activity_date,'YYYY-MM-DD') as day,
count(distinct user_id) as active_users 
from activity
where activity_date > TO_CHAR(TO_DATE('2019-07-27', 'YYYY-MM-DD') - 30, 'YYYY-MM-DD')
and activity_date <= TO_CHAR(TO_DATE('2019-07-27', 'YYYY-MM-DD'))
group by activity_date
order by activity_date;
